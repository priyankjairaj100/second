__pycache__/
*.pyc
.venv/
tmp/
output/pdf/*.aux
output/pdf/*.log
output/pdf/*.out
*.zip

# User-local empirical workspaces; publish selected evidence explicitly.
local_runs/

# Revision 12 derived full-model code arrays; hashes and receipts are published.
/pilots/v12/**/outputs/*.codes.bin
/pilots/v12/**/writer.lock
/pilots/v12/**/phase-cpu-budget/ledger.lock
/pilots/v13/**/outputs/*.bin
/pilots/v13/**/writer.lock
/pilots/v13/**/phase-cpu-budget/ledger.lock

/pilots/*.lock
/pilots/v15/attempt-*/outputs/*.bin
/pilots/v15/attempt-*/writer.lock
/pilots/v15/attempt-*/phase-cpu-budget/ledger.lock
/pilots/v15/*.lock
/pilots/v*/attempt-*/outputs/.*
/pilots/v13/*-controller.lock
/pilots/v14/**/outputs/*.bin
/pilots/v14/**/outputs/*.codes.bin
/pilots/v14/**/writer.lock
/pilots/v14/**/phase-cpu-budget/ledger.lock
/pilots/v14/*-controller.lock

# Revision 16 publishes receipts and hashes, not reproducible code arrays.
/pilots/v16/attempt-*/outputs/*.bin
/pilots/v16/attempt-*/writer.lock
/pilots/v16/attempt-*/phase-cpu-budget/ledger.lock
/pilots/v17/attempt-*/outputs/*.bin
/pilots/v17/attempt-*/writer.lock
/pilots/v17/attempt-*/phase-cpu-budget/ledger.lock

# Revisions 20 and 21 publish code, protocols, receipts, and artifact hashes.
/pilots/v20/attempt-*/outputs/*.bin
/pilots/v20/attempt-*/writer.lock
/pilots/v20/attempt-*/phase-cpu-budget/ledger.lock
/pilots/v21/attempt-*/outputs/*.bin
/pilots/v21/attempt-*/writer.lock
/pilots/v21/attempt-*/phase-cpu-budget/ledger.lock

# Revision 22 derived state conversion artifacts are reconstructible.
/pilots/v22/**/*.bin

# Revision 23 publishes protocols and receipts, not derived model arrays.
/campaigns/fixed_feature_v23/attempts/*/outputs/*.bin
/campaigns/fixed_feature_v23/attempts/*/worker/writer.lock
/campaigns/fixed_feature_v23/phase-cpu-budget/ledger.lock
/campaigns/fixed_feature_v23/attempts/*/outputs/.*
