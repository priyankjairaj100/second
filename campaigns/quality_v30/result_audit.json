{"audit_cost":{"elapsed_ns":389335587,"process_cpu_ns":383747910,"scope":"archive analysis outside empirical worker accounting; excludes final audit serialization and write"},"audit_scope":"internal read-only check; not external peer review; no new empirical run","audit_source":"\"\"\"Read-only evidence audit; no model loading or inference.\"\"\"\nimport hashlib,json,math,time\nfrom pathlib import Path\nimport numpy as np\nimport sys\nroot=Path('/workspace/scratch/50cc2e342461/second')\nsys.path.insert(0,str(root))\nfrom src.run_store import canonical_json,digest\nfrom src.experiment_inventory import source_hashes\nstarted=time.perf_counter_ns();cpu=time.process_time_ns()\nbindings={}\ndef bind(path):\n    path=Path(path)\n    if not path.is_absolute():path=root/path\n    with path.open('rb') as f:sha=hashlib.file_digest(f,'sha256').hexdigest()\n    entry=dict(bytes=path.stat().st_size,sha256=sha)\n    bindings[str(path.relative_to(root))]=entry\n    return entry\ndef raw(path):\n    bind(path);return (root/path).read_bytes()\ndef read(path):return json.loads(raw(path))\nbase=Path('campaigns/research_v30');attempt=base/'attempts/quality-001'\nregpath=Path('campaigns/quality_v30/registration.json')\nreg=read(regpath);program=read(base/'program.json');protocol=read(base/'protocol.json');controller=read(base/'registration.json')\nplan=read(attempt/'plan.json');receipt=read(attempt/'worker/result.json');tx=read(attempt/'transaction.json')\nterminal=raw(attempt/'outputs/completion.json');result=json.loads(terminal)\nassert terminal==raw(attempt/'outputs/progress.json')==raw(attempt/'sealed-progress.json')\nassert result['status']==receipt['status']==receipt['outcome']['status']==tx['worker_outcome']['status']=='complete'\nassert receipt['outcome']['returncode']==0 and receipt['budget_debit']['state']=='settled'\nassert tx['receipt_sha256']==digest(raw(attempt/'worker/result.json'))\nassert result['plan_sha256']==receipt['worker_identity']['plan_sha256']==digest(raw(attempt/'plan.json'))\nassert result['registration_sha256']==plan['registration']['sha256']==digest(raw(regpath))\nassert plan['program_sha256']==controller['program_sha256']==protocol['program_sha256']==digest(raw(base/'program.json'))\nassert plan['protocol_sha256']==controller['protocol_sha256']==digest(raw(base/'protocol.json'))\nassert plan['source_sha256']==program['source_sha256']==source_hashes(root/base/'source')\nfor path,sha in program['source_sha256'].items():assert bind(base/'source'/path)['sha256']==sha\nfor path,sha in program['historical_frozen_ledgers'].items():assert bind(path)['sha256']==sha\nfor name,entry in receipt['artifacts'].items():\n    matches=list((root/attempt/'worker').glob('**/'+name));assert len(matches)==1\n    assert bind(matches[0])==entry\nstdout_path=next((root/attempt/'worker').glob('**/stdout-summary.json'))\nstdout=json.loads(stdout_path.read_bytes())\nassert '\"terminal_sha256\": \"'+digest(terminal)+'\"' in stdout['tail_utf8']\nfor entry in result['artifacts'].values():\n    assert Path(entry['file']).name==entry['file']\n    assert bind(attempt/'outputs'/entry['file'])==dict(bytes=entry['bytes'],sha256=entry['sha256'])\nassert set(plan['inputs'])==set(reg['inputs'])\nfor name,entry in plan['inputs'].items():\n    assert bind(entry['path'])==dict(bytes=entry['bytes'],sha256=entry['sha256'])\n    assert {k:entry[k] for k in ('bytes','sha256')}=={k:reg['inputs'][name][k] for k in ('bytes','sha256')}\n    assert Path(entry['path']).resolve()==(root/reg['inputs'][name]['path']).resolve()\nfor kind in ('fixed','sequential'):\n    item=plan['inputs'];generation_plan=json.loads(Path(item[kind+'_plan']['path']).read_bytes())\n    generation_progress=json.loads(Path(item[kind+'_progress']['path']).read_bytes())\n    generation_receipt=json.loads(Path(item[kind+'_receipt']['path']).read_bytes())\n    assert generation_progress['status']==generation_receipt['outcome']['status']=='complete'\n    assert generation_receipt['budget_debit']['state']=='settled'\n    assert generation_progress['plan_sha256']==generation_receipt['worker_identity']['plan_sha256']==item[kind+'_plan']['sha256']\n    assert generation_progress['model_artifact']['sha256']==item[kind+'_model']['sha256']\n    assert generation_progress['model_artifact']['bytes']==item[kind+'_model']['bytes']\npools=json.loads(Path(plan['inputs']['pools']['path']).read_bytes())\nold=json.loads(Path(plan['inputs']['old_evaluation']['path']).read_bytes())\noldids=set(old['excluded_from_future_confirmation_ids']);assert len(oldids)==12\nexpected=[r for r in pools['evaluation'] if r['id'] not in oldids and len(r['tokens'])>=128][:8]\nids=[r['id'] for r in reg['records']]\nassert ids==[r['id'] for r in expected] and len(ids)==len(set(ids))==8\nassert all(r['tokens']==s['tokens'][:128] and r['body_sha256']==s['body_sha256'] for r,s in zip(reg['records'],expected))\nassert set(ids).isdisjoint(oldids|{r['id'] for r in pools['confirmation']})\nassert reg['prior_exclusions']==sorted(oldids)\nassert result['excluded_from_future_confirmation_ids']==reg['excluded_from_future_confirmation_ids']==sorted(oldids|set(ids))\nassert len(result['excluded_from_future_confirmation_ids'])==20\nlabels=['full_precision','nearest_rounding','fixed_feature','sequential']\nassert reg['labels']==labels and set(result['quality'])==set(labels)\nassert [(p['record_id'],p['model']) for p in result['phases'] if p['phase']=='quality_started']==[(rid,label) for rid,order in zip(ids,reg['quality_order']) for label in order]\nassert [(p['record_id'],p['model']) for p in result['phases'] if p['phase']=='quality_complete']==[(rid,label) for rid,order in zip(ids,reg['quality_order']) for label in order]\nfirstnew=next(i for i,p in enumerate(result['phases']) if p['phase']=='quality_started')\nassert sum(p['phase']=='historical_parity_record' for p in result['phases'][:firstnew])==4\nmaxdev=max(p['absolute_mean_nll_deviation'] for p in result['historical_parity'])\nassert maxdev<=reg['historical_parity_max_mean_nll_deviation'] and result['historical_parity_pass']\nloss={}\nfor label in labels:\n    table={r['id']:r for r in result['quality'][label]}\n    assert len(table)==len(result['quality'][label])==8 and set(table)==set(ids)\n    assert {r['predictions'] for r in table.values()}=={127}\n    assert all(math.isfinite(r['nll_sum']) and math.isclose(r['mean_nll'],r['nll_sum']/127,rel_tol=0,abs_tol=1e-14) for r in table.values())\n    values=np.array([table[rid]['nll_sum'] for rid in ids]);loss[label]=values\n    total=result['summary']['totals'][label]\n    assert total['predictions']==1016\n    assert math.isclose(total['nll_sum'],math.fsum(values),rel_tol=0,abs_tol=1e-11)\n    assert math.isclose(total['perplexity'],math.exp(math.fsum(values)/1016),rel_tol=0,abs_tol=1e-12)\nrng=np.random.default_rng(reg['bootstrap_seed'])\nindices=rng.integers(0,8,size=(reg['bootstrap_repetitions'],8))\nwin_counts={};details={}\nfor reference in ('sequential','nearest_rounding','full_precision'):\n    delta=loss['fixed_feature']-loss[reference]\n    ratio=math.exp(math.fsum(delta)/1016)\n    intervals=np.quantile(delta[indices].sum(axis=1)/1016,[.025,.975],method='linear')\n    observed=result['summary']['fixed_feature_comparisons'][reference]\n    assert math.isclose(observed['perplexity_ratio'],ratio,rel_tol=0,abs_tol=1e-14)\n    np.testing.assert_allclose(observed['paired_article_bootstrap_95_percentile_nll'],intervals,rtol=0,atol=1e-14)\n    np.testing.assert_allclose(observed['paired_article_bootstrap_95_percentile_ratio'],np.exp(intervals),rtol=0,atol=1e-14)\n    for rid,d in zip(ids,delta):assert math.isclose(observed['article_perplexity_ratios'][rid],math.exp(d/127),rel_tol=0,abs_tol=1e-14)\n    win_counts[reference]=dict(fixed_feature_better=int((delta<0).sum()),equal=int((delta==0).sum()),fixed_feature_worse=int((delta>0).sum()))\n    details[reference]=dict(perplexity_ratio=ratio,percent_change=100*(ratio-1),**win_counts[reference])\nprimary=result['summary']['fixed_feature_comparisons']['sequential']\ngate=primary['perplexity_ratio']<=reg['gate']['max_aggregate_ratio_to_sequential'] and max(primary['article_perplexity_ratios'].values())<=reg['gate']['max_each_article_ratio']\nassert gate==result['development_quality_gate_pass']==True\nassert result['primary_observed_win']==(primary['perplexity_ratio']<1)\nassert receipt['resource_usage']['total_cpu_ns']==receipt['budget_debit']['observed_cpu_ns']\nassert math.ceil(receipt['budget_debit']['observed_cpu_ns']/1e9)==receipt['budget_debit']['charged_cpu_seconds']==39\nassert result['peak_rss_bytes']==receipt['resource_usage']['max_rss_kib']*1024\nassert all(result[k] is False for k in ('confirmation','scientific_promotion','calibration_target_changed'))\nassert result['evaluation_arithmetic_changed'] is True\nbind('docs/QUALITY_PROTOCOL_V30.md');bind('docs/QUALITY_RESULTS_V30.md');bind('tests/test_quality_v30.py')\nsource=Path(__file__).read_text()\nout=dict(schema='quality-result-audit-v30',status='passed',no_model_inference=True,\n    audit_scope='internal read-only check; not external peer review; no new empirical run',\n    checks=['registration and plan binding','frozen source inventory','all historical ledgers unchanged',\n            'three terminal files identical','receipt artifacts exact','terminal hash in bound stdout',\n            'all external input hashes and sizes','both historical model generation chains',\n            'article selection and all twenty exclusions','matched counts and prospective order',\n            'all historical parity checks precede new inference','independent loss and ratio recomputation',\n            'whole paired article bootstrap recomputation','registered primary gate','settled cost and peak RSS'],\n    terminal_sha256=digest(terminal),registration_sha256=digest(raw(regpath)),\n    comparisons=details,maximum_historical_mean_nll_deviation=maxdev,\n    complete_controller_seconds=tx['controller_elapsed_ns']/1e9,\n    observed_cpu_seconds=receipt['budget_debit']['observed_cpu_ns']/1e9,\n    charged_cpu_seconds=39,peak_rss_bytes=result['peak_rss_bytes'],\n    excluded_from_future_confirmation_ids=result['excluded_from_future_confirmation_ids'],\n    remaining_unevaluated_pool_articles=len(set(r['id'] for r in pools['evaluation'])-set(result['excluded_from_future_confirmation_ids'])),\n    limits=['eight development articles','sixteen retained calibration tokens','one model and corpus',\n            'fixed selection gives no population coverage claim','bootstrap intervals are descriptive',\n            'full precision remains better on every article','no repair or lifetime speed inference'],\n    evidence=bindings,evidence_file_count=len(bindings),\n    audit_source=source,audit_source_sha256=digest(source.encode()),\n    audit_cost=dict(process_cpu_ns=time.process_time_ns()-cpu,elapsed_ns=time.perf_counter_ns()-started,\n                    scope='archive analysis outside empirical worker accounting; excludes final audit serialization and write'))\npath=root/'campaigns/quality_v30/result_audit.json'\nwith path.open('xb') as f:f.write(canonical_json(out))\nprint(json.dumps({k:out[k] for k in ('status','evidence_file_count','comparisons','audit_cost')}))\n","audit_source_sha256":"9f0b46340068567b420c7fb6776e767be0def71ffa0395a382b8bc6c6134d23d","charged_cpu_seconds":39,"checks":["registration and plan binding","frozen source inventory","all historical ledgers unchanged","three terminal files identical","receipt artifacts exact","terminal hash in bound stdout","all external input hashes and sizes","both historical model generation chains","article selection and all twenty exclusions","matched counts and prospective order","all historical parity checks precede new inference","independent loss and ratio recomputation","whole paired article bootstrap recomputation","registered primary gate","settled cost and peak RSS"],"comparisons":{"full_precision":{"equal":0,"fixed_feature_better":0,"fixed_feature_worse":8,"percent_change":26.698001957486838,"perplexity_ratio":1.2669800195748684},"nearest_rounding":{"equal":0,"fixed_feature_better":7,"fixed_feature_worse":1,"percent_change":-10.938518078710558,"perplexity_ratio":0.8906148192128944},"sequential":{"equal":0,"fixed_feature_better":3,"fixed_feature_worse":5,"percent_change":-0.1434326251966711,"perplexity_ratio":0.9985656737480333}},"complete_controller_seconds":38.829331821,"evidence":{"campaigns/compressed_timing_v27/phase-cpu-budget/ledger.json":{"bytes":11327,"sha256":"36fc2a2dbc7174f5bfdf204d94827e3afc9ba430e1024f94cd30a8024a252fea"},"campaigns/compressed_timing_v28/phase-cpu-budget/ledger.json":{"bytes":11342,"sha256":"75bb29191cdfbff6b6787f61e803aab327cfd5501ea6c5d6614e626439c952b8"},"campaigns/compressed_v25b/phase-cpu-budget/ledger.json":{"bytes":10521,"sha256":"bb4828857fb93b77ed834ace545a84b0986f9f1069bcec240a3b89f272c61cfd"},"campaigns/compressed_v25c/phase-cpu-budget/ledger.json":{"bytes":10632,"sha256":"1718bf09120dfc772f87c3c51d9f8e8d7a97da8f6fb6fd119afd774328bcf7a7"},"campaigns/compressed_v25d/phase-cpu-budget/ledger.json":{"bytes":10610,"sha256":"e1706ad7592424d7c222158b4b0b16611c7ae77eb10b753cc71e8c6d9e8491d4"},"campaigns/compressed_v26b/phase-cpu-budget/ledger.json":{"bytes":10827,"sha256":"b36358f3ad033d1d0d6a71b5c9caa5c181106c0065c74f93919b193b6506acce"},"campaigns/compressed_v27/phase-cpu-budget/ledger.json":{"bytes":10921,"sha256":"cc80ce11d3c0bde04d2f70e915e583df97e402c82d4250fd0872be9566a62f84"},"campaigns/compressed_v28/phase-cpu-budget/ledger.json":{"bytes":11023,"sha256":"fc2440a842080ef6ae8e8c1adfd7fe40fec43bc5d6b06bbff7b22998d987114d"},"campaigns/fixed_feature_v23/incidents/warm-cold-001/phase-cpu-budget/ledger.json":{"bytes":11087,"sha256":"798f64a935d043cd04fd4cc65f29bacc35f9edcfc8f3e9f07147cabfcb5b27c5"},"campaigns/fixed_feature_v23/phase-cpu-budget/ledger.json":{"bytes":12419,"sha256":"63f0b83378857156a4661564e11828618f78b5e8085354ddfb67fd2c000913c9"},"campaigns/lossless_timi